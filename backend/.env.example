# Environment configuration for the reusable Groq client.
# Copy to .env or export these values in your shell. Never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# Approval workflow provider mode. Allowed values: local, mcp_mock.
# local keeps the existing local Notes and mock Gmail draft providers.
# mcp_mock executes only the two allowlisted local mock MCP tools.
APPROVAL_PROVIDER_MODE=local

# Comma-separated explicit browser origins allowed to call the API.
# Wildcard "*" is not allowed. Example for local development:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173